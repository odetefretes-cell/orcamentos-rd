# obs-fiscal — copiar para /etc/obs-fiscal/.env na VPS e preencher.
PORT=3003

# mesmo segredo compartilhado dos outros serviços (obs-api injeta no proxy)
OBS_SHARED_SECRET=

# ---- Focus NFe (Fase 1: conta teste 30 dias — focusnfe.com.br) ----
# Sem token, o serviço roda em MODO PREVIEW: monta o JSON do CT-e mas não emite.
FOCUS_TOKEN=
# homologacao | producao   (SÓ mudar pra producao depois do contador validar)
FOCUS_AMBIENTE=homologacao

# ---- Emitente (dados da OBS — preencher com o contador na Fase 0) ----
EMIT_CNPJ=
EMIT_IE=
EMIT_RAZAO=OBS TRANSPORTES
EMIT_FANTASIA=OBS Transportes
EMIT_LOGRADOURO=
EMIT_NUMERO=
EMIT_BAIRRO=
EMIT_MUNICIPIO=
EMIT_UF=
EMIT_CEP=
# Regime tributário: 1=Simples Nacional, 3=Normal (confirmar com o contador)
EMIT_CRT=3

# ---- Parametrização fiscal (DEFINIR COM O CONTADOR — Fase 0, item 4) ----
# CFOP da prestação de serviço de transporte (varia por operação intra/interestadual)
FISCAL_CFOP_INTRA=
FISCAL_CFOP_INTER=
# CST/alíquota de ICMS padrão (o contador define por cenário)
FISCAL_ICMS_CST=
FISCAL_ICMS_ALIQ=

# ---- Averbadora (Fase 3 — preencher após resposta da corretora) ----
AVERBADORA=            # atm | seguradora | automatica
ATM_USUARIO=
ATM_SENHA=
ATM_CODIGO=
