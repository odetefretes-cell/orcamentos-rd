# ============================================================================
# MODELO das variáveis de ambiente do robô. NO VPS, copie para ".env" e preencha.
# O ".env" NUNCA vai pro GitHub (está no .gitignore). Os segredos vivem SÓ aqui.
# ============================================================================

# --- Firebase: chave de administrador (conta de serviço) ---
# Firebase Console -> obs-fretes -> Configurações do projeto -> Contas de serviço
# -> "Gerar nova chave privada" -> baixa um JSON. Cole o JSON INTEIRO numa linha só.
FIREBASE_SERVICE_ACCOUNT=

# --- ChatGuru API (mesmos valores que já estão nos segredos do Firebase) ---
CHATGURU_API_URL=https://s22.chatguru.app/api/v1
CHATGURU_API_KEY=
CHATGURU_ACCOUNT_ID=67e2e2f7895b4e2e2ed944b0
CHATGURU_PHONE_ID=67ec49e82415efebeb055070

# --- ChatGuru WEB: login que o robô usa pra RASPAR a tela (ler conversas) ---
CHATGURU_URL_WEB=https://s22.chatguru.app
CHATGURU_LOGIN_USER=
CHATGURU_LOGIN_PASS=

# --- Anthropic (Claude) — mesmo valor do Firebase, pra extração/decisão ---
ANTHROPIC_API_KEY=
