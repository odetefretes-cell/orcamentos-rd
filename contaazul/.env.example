# ===== Servidor =====
PORT=3000
NODE_ENV=production
# Caminho do banco SQLite. NO VPS use um caminho FIXO e com backup, ex.:
DB_PATH=/var/www/obs-ca/data/obs-ca.db

# Segredo que o site do OBS envia no header X-OBS-Secret (invente um longo)
OBS_SHARED_SECRET=troque-por-um-segredo-longo-aleatorio

# Domínio do sistema OBS, para liberar CORS (ex.: https://sistema.obstransportes.com.br)
OBS_ORIGIN=https://sistema.obstransportes.com.br

# ===== Conta Azul (app de PRODUÇÃO) =====
CA_CLIENT_ID=
CA_CLIENT_SECRET=
# URL pública deste backend + /oauth/callback (tem que bater com o app do CA)
CA_REDIRECT_URI=https://api.obstransportes.com.br/oauth/callback
# padrões (só mude para o mock em teste)
CA_AUTH_URL=https://login.contaazul.com/#/oauth/authorize
CA_TOKEN_URL=https://api-v2.contaazul.com/oauth/token
CA_API_BASE=https://api-v2.contaazul.com
CA_SCOPE=openid profile aws.cognito.signin.user.admin

# ===== UUIDs dos serviços cadastrados no Conta Azul =====
# (Serviços > Cadastros > Serviços). A API exige serviço, não aceita texto livre.
SERVICE_CEGONHA_ID=
SERVICE_GUINCHO_ID=

# ===== Nomes de categoria / centro de custo (já existem na conta) =====
CAT_RECEITA=Fretes recebidos
CAT_DESPESA=Materiais Aplicados na Prestação de Serviços
CENTRO_CUSTO_PADRAO=FRETES
CENTRO_CUSTO_GUINCHO=GUINCHO

# ===== Regras =====
PARCELA2_FALLBACK_DIAS=15
RECONCILE_INTERVAL_MS=300000
