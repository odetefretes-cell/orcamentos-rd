rules_version = '2';

// ============================================================================
// Regras de segurança do Firestore — OBS Transportes (projeto obs-fretes)
// Fase 1 do plano de segurança. Trava o "dump" da base (leitura de todos os
// dados) mantendo os fluxos do cliente e a automação funcionando.
//
// MODELO:
//   • EQUIPE (7 e-mails oficiais, logados no Firebase) -> acesso total.
//   • Cliente com link -> só lê a CÓPIA pública (publico/) e, no caso de
//     PEDIDO pendente, lê o formulário e envia os próprios dados.
//   • Automação (Make/ChatGuru) e formulário do site -> só CRIAM/ATUALIZAM
//     leads (interim — a Fase 1b move isso p/ uma função na nuvem com segredo).
//   • Ninguém de fora lê fretes cadastrados, clientes, tabela ou configurações.
//
// REVERSÍVEL: se algo travar, é só republicar as regras antigas (abaixo).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Só os 7 e-mails oficiais da OBS contam como "equipe" (mesmo que alguém
    // crie uma conta Firebase por fora, sem estar nesta lista não acessa nada).
    function ehEquipe() {
      return request.auth != null && request.auth.token.email in [
        'atendimento@obstransportes.com.br',
        'yasminfreitas.obs@outlook.com',
        'thiagolucca.obs@outlook.com',
        'flavia.obs@outlook.com',
        'nataly.obs@outlook.com',
        'yasmindesa.obs@outlook.com',
        'financeiro@obstransportes.com.br'
      ];
    }

    // ---- Cópia pública do acompanhamento (só leitura) -----------------------
    // O cliente abre o link e vê SÓ o subconjunto seguro do frete dele.
    match /publico/{id} {
      allow read:  if true;
      allow write: if ehEquipe();
    }

    // ---- Fretes -------------------------------------------------------------
    // Equipe: tudo. Cliente: só PEDIDO PENDENTE (pedido==false e cadastrado==false)
    // — pode ler o formulário e enviar os próprios dados. Fretes cadastrados
    // (com CPF/endereço) e configs (_acesso, _tabela…) ficam SÓ para a equipe:
    // os docs de config não têm esses campos, então a regra do cliente não os pega.
    match /fretes/{id} {
      allow read, write:  if ehEquipe();
      allow read, update: if resource.data.get('pedido', true) == false
                          && resource.data.get('cadastrado', true) == false;
    }

    // ---- CRM (leads) — Fase 1b: porteiro por SEGREDO ------------------------
    // Equipe logada (Firebase Auth): acesso total. A automação ChatGuru/Make
    // (server-side) cria/atualiza leads enviando o SEGREDO combinado no campo
    // "_porta". Sem o segredo, ninguém de fora cria nem altera lead.
    //
    // IMPORTANTE: este repositório é PÚBLICO. O valor real do segredo NÃO fica
    // aqui — o texto abaixo é só um marcador. Cole o segredo verdadeiro apenas:
    //   (1) nas Regras publicadas no Console do Firebase, e
    //   (2) na configuração do módulo do Firestore no Make (campo "_porta").
    // O app da equipe NÃO precisa do segredo (escreve autenticado via ehEquipe).
    match /crm_leads/{id} {
      allow read, write:    if ehEquipe();
      allow create, update: if request.resource.data.get('_porta', '') == 'COLE_O_SEGREDO_DO_MAKE_AQUI';
    }

    // ---- Todo o resto: clientes, tabela de rotas, _acesso, _etapas, etc. ----
    match /{document=**} {
      allow read, write: if ehEquipe();
    }
  }
}

// ============================================================================
// PARA REVERTER (se algo travar): republique estas regras antigas (tudo aberto):
//
// rules_version = '2';
// service cloud.firestore {
//   match /databases/{database}/documents {
//     match /{document=**} { allow read, write: if true; }
//   }
// }
// ============================================================================
