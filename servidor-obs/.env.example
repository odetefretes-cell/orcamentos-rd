# ===========================================================================
#  MODELO das variaveis de ambiente do robo da OBS
#  No servidor o arquivo real fica em /etc/obs-robo/.env (chmod 640, fora do repo).
#  ESTE arquivo (.env.example) vai pro GitHub SEM NENHUM VALOR preenchido.
# ===========================================================================

# --- modo de operacao ---
# true  = SO LOGA o que faria (nao envia nada, nao grava nada). Comece sempre assim.
# false = executa de verdade.
DRY_RUN=true
TZ=America/Sao_Paulo

# --- Firebase (conta de servico do projeto obs-fretes) ---
# Cole o JSON convertido em base64:   cat chave.json | base64 -w0
FIREBASE_SERVICE_ACCOUNT_BASE64=
# (alternativa) JSON em uma unica linha:
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=obs-fretes

# --- ChatGuru API ---
CHATGURU_API_URL=https://s22.chatguru.app/api/v1
CHATGURU_API_KEY=
CHATGURU_ACCOUNT_ID=
CHATGURU_PHONE_ID=

# --- ChatGuru login (usuario DEDICADO do robo, nao de operador) ---
CHATGURU_LOGIN_URL=https://s22.chatguru.app/login
CHATGURU_LOGIN_USER=
CHATGURU_LOGIN_PASS=

# --- Anthropic ---
ANTHROPIC_API_KEY=
