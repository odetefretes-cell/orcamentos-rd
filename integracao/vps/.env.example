OBS_API_TOKEN=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

CHATGURU_API_KEY=
CHATGURU_ACCOUNT_ID=67e2e2f7895b4e2e2ed944b0
CHATGURU_PHONE_ID=67ec49e82415efebeb055070
CHATGURU_API_URL=https://s22.chatguru.app/api/v1

LIMITE_VALOR_HUMANO=500000
LEAD_JANELA_SEGUNDOS=60
MAX_PERGUNTAS=2
VENDEDORES=Yasmim Freitas,Thiago Lucca,Flavia Ottati
TELEFONE_OBS=(11) 4352-4103

# Conversões offline → planilha do Google Ads (integracao/conversoes-sheets.js).
# Chave JSON da SERVICE ACCOUNT — fica fora do repositório, só no servidor:
#   /etc/obs-automacao/google-sa.json  (chmod 600, dono obsrobo)
# A planilha precisa estar compartilhada com o client_email da chave como EDITOR.
# Sem esta variável o job só avisa no log e não escreve nada.
GOOGLE_SA_KEY_FILE=/etc/obs-automacao/google-sa.json
ADS_SHEET_ID=1kaDe2x6UqnPOpiJ1ZeXF9B0T5rbK83_VwsgvSzKYTQg

PORT=3001
HOST=127.0.0.1
TZ=America/Sao_Paulo
