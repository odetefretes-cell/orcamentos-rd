# ============================================================================
# OBS Transportes — variáveis de ambiente da integração
#
# COMO USAR:
#   1. Copie este arquivo para ".env"  ->  cp .env.example .env
#   2. Preencha os valores reais no .env (o .env NUNCA vai pro Git).
#   3. No Firebase, os segredos sobem com "firebase functions:secrets:set NOME".
#
# Nesta ETAPA 1+2 (receber o webhook e salvar), você NÃO precisa preencher
# quase nada — o webhook de entrada funciona sem token. As variáveis do
# ChatGuru abaixo são pra ETAPA 5 (enviar a resposta) e ficam aqui só prontas.
# ============================================================================

# --- Webhook de entrada (Etapa 1+2) -----------------------------------------
# Tempo (em segundos) que esperamos sem mensagem nova antes de considerar o
# lead "completo". Fácil de ajustar. Padrão: 60.
LEAD_JANELA_SEGUNDOS=60

# (Opcional) Segredo compartilhado com o ChatGuru. Se preencher, o ChatGuru
# precisa mandar o cabeçalho "X-CG-Secret" com o mesmo valor. Deixe vazio pra
# começar testando sem proteção.
CG_WEBHOOK_SECRET=

# --- API do ChatGuru (Etapa 5 — ENVIO da resposta; ainda não usado) ---------
# Endpoint base da API do ChatGuru.
CHATGURU_API_URL=https://s22.chatguru.app/api/v1
# Credenciais da sua conta no ChatGuru (pegue no painel do ChatGuru).
CHATGURU_API_KEY=
CHATGURU_ACCOUNT_ID=
CHATGURU_PHONE_ID=

# --- API da Anthropic (Etapa 4 — extração/decisão; ainda não usado) ---------
ANTHROPIC_API_KEY=
